{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Incident Reporting",
  "version": "0.1.1",
  "identifier": "nz.incident-reporting.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Incident Reporting",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Hospital incident reporting — messy Excel in, clean trend reporting out.",
    "longDescription": "Desktop tool for hospital H&S teams. Ingests an incident-export .xlsx and produces modern trend reporting across the department hierarchy. Runs fully offline.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/alex-poor/jexcel/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDNkNCQTQ2NzIxQjcxNkEKUldScWNSdHlScnBzYkhXSWc3dHZXdkk5eDI5QWswMjlVY0VXMTY5T28zSDVtTEV3dzlqb0k5TWkK"
    }
  }
}
